# Banco Ágil — variáveis de ambiente. Copie para `.env` e preencha.
# NUNCA comite o `.env` (já está no .gitignore, assim como os backups `.env.bak-*`).
#
# A aba "Configurações" da interface escreve neste arquivo por você — sempre com
# confirmação explícita e criando antes um backup `.env.bak-<data-hora>`.

# Cadeia de modelos: o primeiro que responder atende a conversa.
# Se o da frente falhar por infraestrutura (quota, indisponibilidade, timeout,
# modelo descontinuado), o seguinte assume NO MESMO TURNO — o cliente não percebe.

# Provedores: gemini | openai | openrouter | groq | togetherai | ollama | compativel | fake
LLM_PROVIDER=openrouter

# Modelo do provedor padrão (vazio = default do provedor, ver llm/factory.py)
LLM_MODEL=

# Fallbacks, no formato `provedor:modelo` (o modelo pode conter `:` e `/`).
# Exemplo de cadeia de três provedores diferentes:
#   LLM_FALLBACK_1=openrouter:google/gemma-4-26b-a4b-it:free
#   LLM_FALLBACK_2=groq:llama-3.3-70b-versatile
# Deixe vazio para não ter fallback. Dica: use provedores DIFERENTES — dois
# modelos do mesmo provedor compartilham a quota e o fallback vira decoração.
LLM_FALLBACK_1=
LLM_FALLBACK_2=

# Quantas tentativas por modelo antes de trocar para o próximo (padrão 2).
# Só vale para soluço passageiro (5xx, timeout): quota estourada troca na hora.
LLM_TENTATIVAS_POR_MODELO=2

# Modelos opcionais por papel de agente (sobrepõem LLM_MODEL quando preenchidos).
# Útil para usar modelo barato na triagem e um mais forte na entrevista de crédito.
LLM_MODEL_TRIAGE=
LLM_MODEL_CREDIT=
LLM_MODEL_INTERVIEW=
LLM_MODEL_FX=

# Temperatura (0 = determinístico, recomendado para agentes com regra de negócio)
LLM_TEMPERATURE=0

# Chaves — apenas a do provedor escolhido acima é obrigatória.
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=

# Endpoint para o provedor `compativel` (vLLM, LM Studio, qualquer API
# compatível com OpenAI).
LLM_BASE_URL=

# Ollama local
OLLAMA_BASE_URL=http://localhost:11434

# Aplicação
BANCO_AGIL_DATA_DIR=data
BANCO_AGIL_LOG_LEVEL=INFO
BANCO_AGIL_MAX_TENTATIVAS_AUTENTICACAO=3
BANCO_AGIL_FX_TIMEOUT_SECONDS=6
